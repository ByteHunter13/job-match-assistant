# Copy this file to `.env` and fill in real values. Never commit `.env`.
#   cp .env.example .env

# --- PostgreSQL + pgvector (used by docker-compose.yml) ---
POSTGRES_USER=jobmatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=job_assistant
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection string for the Python backend (SQLAlchemy / psycopg)
DATABASE_URL=postgresql+psycopg://jobmatch:change-me@localhost:5432/job_assistant

# --- Job sources (Phase 1) ---
# Adzuna: register at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Kaggle: https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Local LLM (Phase 5) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
